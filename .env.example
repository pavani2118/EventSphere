# Copy this file to a secure local environment configuration.
# Do not commit the copied file or replace these placeholders with secrets.
PGHOST=localhost
PGPORT=5432
PGDATABASE=eventsphere_db
PGUSER=postgres
PGPASSWORD=replace-with-local-secret
PGSSLMODE=prefer
WAITLIST_EXPIRY_INTERVAL_SECONDS=3600
CRON_SECRET=replace-with-cron-secret
